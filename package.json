{
  "name": "dsh-codex-runs",
  "version": "0.1.0",
  "description": "Read-only panel for Codex CLI run history: scans ~/.codex/sessions rollouts (last 7 days) and serves GET /api/codex-runs to a collapsible web panel.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 || ^0.2.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "codex",
    "codex-cli",
    "sessions",
    "rollout",
    "observability"
  ],
  "license": "MIT"
}
